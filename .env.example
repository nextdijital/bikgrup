# ==============================================================================
# BİKGRUP - Canlı Sunucu (Production) Yapılandırma Dosyası
# Canlı sunucunuza yüklerken bu dosyanın adını ".env" yaparak veritabanı
# ve alan adı bilgilerinizi giriniz.
# ==============================================================================

# Uygulama Ortamı: "production" (Canlı) veya "development" (Geliştirme)
APP_ENV=production

# Sitenizin Tam Alan Adı (SSL Protokolüyle Birlikte)
# Örnek: https://bikgrup.com veya https://www.bikgrup.com
APP_URL=https://bikgrup.com

# Canlı MySQL / MariaDB Veritabanı Bağlantı Bilgileri
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bikgrup_db
DB_USER=bikgrup_user
DB_PASS=GucluSifreniz123!
DB_CHARSET=utf8mb4

